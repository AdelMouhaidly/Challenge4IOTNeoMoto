{
  "expo": {
    "name": "Mottu",
    "slug": "Mottu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O app precisa de acesso às suas fotos para detectar motos.",
          "cameraPermission": "O app precisa de acesso à câmera para tirar fotos.",
          "mediaLibraryPermission": "O app precisa de acesso à galeria de mídia para selecionar imagens."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4CAF50",
          "sounds": []
        }
      ],
      "expo-localization",
      "expo-asset",
      "expo-system-ui"
    ],
    "extra": {
      "commitHash": "21fd1a6",
      "eas": {
        "projectId": "3c0a5de9-8f28-4436-a963-3d007925ea10"
      }
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA"
      ],
      "package": "com.adelmouhaidly.Mottu"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
